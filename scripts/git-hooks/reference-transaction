#!/usr/bin/env bash
# Сторож истории (docs/GIT.md → «Запрещённые команды»): ветки только растут вперёд, stash запрещён.
# Ловит --amend, rebase, reset назад, branch -f, stash — всё, что переписывает или прячет работу. Не обходится --no-verify.
# Исключение одно: ветка task/*, перенесённая на текущий main (rebase перед финальными тестами).
[ "${1:-}" = "prepared" ] || exit 0

rebase_in_progress() {
    [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]
}

rewritten=()
stashed=0
while read -r old new ref; do
    case "$ref" in
        refs/stash)
            [[ "$new" =~ ^0+$ ]] || stashed=1
            ;;
        refs/heads/*)
            [[ "$old" =~ ^0+$ || "$new" =~ ^0+$ || "$old" == "$new" ]] && continue
            git merge-base --is-ancestor "$old" "$new" 2>/dev/null && continue
            # Финал ветки задания: перенос task/* на текущий main (docs/GIT.md → «Финал ветки: rebase на main»).
            if [[ "$ref" == refs/heads/task/* ]] && rebase_in_progress && git merge-base --is-ancestor refs/heads/main "$new" 2>/dev/null; then
                continue
            fi
            rewritten+=("$ref")
            ;;
    esac
done

if [ "$stashed" -eq 1 ]; then
    cat >&2 <<'EOF'
git stash отклонён.
Почему: в дереве работают несколько агентов — stash забирает и их незакоммиченную работу, а stash pop поверх
изменившихся файлов восстанавливает состояние, которое никто не может проверить.
Как надо: чтобы посмотреть закоммиченную версию файла, ничего не трогая, — git show HEAD:путь/к/файлу.
Правило: docs/GIT.md → «Запрещённые команды».
EOF
    exit 1
fi

if [ "${#rewritten[@]}" -gt 0 ]; then
    cat >&2 <<EOF
Перезапись истории отклонена: ${rewritten[*]} сдвигается так, что прежний коммит перестаёт быть в истории
(--amend, rebase, reset назад, branch -f).
Почему: отчёты о задачах и ревью ссылаются на хэши коммитов — после перезаписи они ведут в никуда,
а чужая работа, попавшая в индекс, уезжает в твой коммит.
Как надо: история только дополняется — ошибку исправляет НОВЫЙ коммит поверх (git commit -m "fix: …").
Правило: docs/GIT.md → «Запрещённые команды».
EOF
    exit 1
fi
exit 0
