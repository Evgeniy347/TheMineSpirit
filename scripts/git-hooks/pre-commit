#!/usr/bin/env bash
# Сторож зелёного коммита (docs/GIT.md → «Коммит»). Подключается scripts/install-git-hooks.sh.
# Если в коммите (индекс, в том числе временный при `git commit -- <пути>`) есть изменения в src/, api/,
# board/, tactics/, content/, rest/, ui/, test-fixtures/, mod/, build-logic/, config/, build.gradle, gradle.properties или
# settings.gradle — прогоняет scripts/test.sh unit и при красном отклоняет коммит.
# Коммиты только документов и скриптов, слияния — без прогона.
WATCHED='^(src/|api/|policy/|mech/|board/|tactics/|content/|rest/|ui/|test-fixtures/|mod/|build-logic/|config/|build\.gradle$|gradle\.properties$|settings\.gradle$)'

git rev-parse -q --verify MERGE_HEAD >/dev/null && exit 0

staged="$(git diff --cached --name-only | grep -E "$WATCHED")"
[ -n "$staged" ] || exit 0

top="$(git rev-parse --show-toplevel)"
cd "$top" || exit 1

# Тесты читают рабочее дерево, а не индекс: незастейдженные правки в наблюдаемых путях попадают в прогон.
unstaged="$( { git diff --name-only; git ls-files --others --exclude-standard; } | grep -E "$WATCHED")"

echo "pre-commit: в коммите есть изменения в src/ или сборке — прогоняю scripts/test.sh unit (зелёный нужен до коммита)…" >&2

# GIT_* из окружения хука не нужны сборке и могут увести её git-команды в чужой индекс.
mkdir -p TestResults/logs
env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX bash scripts/test.sh unit --fast-analyzers >"TestResults/logs/pre-commit-latest.log" 2>&1
code=$?

if [ -n "$unstaged" ]; then
    cat >&2 <<EOF
pre-commit: ВНИМАНИЕ — прогон относится к рабочему дереву, а не к индексу. Не попадут в коммит, но участвовали в тестах:
$(printf '%s\n' "$unstaged" | sed 's/^/  /')
EOF
fi

if [ "$code" -ne 0 ]; then
    cat >&2 <<EOF
Коммит отклонён: scripts/test.sh unit --fast-analyzers красный (код $code).
$(cat TestResults/logs/pre-commit-latest.log)
Почему: красный коммит ломает бисекцию (git bisect попадает на нерабочее состояние) и scripts/prove-red.sh
(он ждёт зелёный на самом коммите), а ревью смотрит на непроверенное.
Как надо: почини код или тест и закоммить зелёное. Поломку в чужой части не прячь — назови её в отчёте;
тест не отключай (@Disabled запрещён, docs/TESTING.md).
Правило: docs/GIT.md → «Коммит».
EOF
    exit 1
fi
echo "pre-commit: scripts/test.sh unit зелёный" >&2
exit 0
