#!/usr/bin/env bash
# Сторож rebase (docs/GIT.md → «Финал ветки: rebase на main»). Разрешён один случай: ветка задания task/* переносится
# на main перед финальным прогоном тестов. Всё остальное — запрещено.
upstream="${1:-}"
branch="${2:-$(git symbolic-ref --quiet --short HEAD 2>/dev/null)}"
if [[ "$branch" == task/* ]] && [ "$upstream" = "main" ]; then
    exit 0
fi
cat >&2 <<EOF
rebase отклонён: ветка «${branch:-отделённый HEAD}», основа «${upstream:-не указана}».
Разрешён только перенос ветки задания на main перед финальными тестами: git rebase main, стоя на task/*.
Почему: rebase меняет хэши; на main и чужих ветках это ломает ссылки в отчётах и ревью и чужую работу.
Правило: docs/GIT.md → «Финал ветки: rebase на main».
EOF
exit 1
