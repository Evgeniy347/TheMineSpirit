#!/usr/bin/env bash
# Сторож запрета rebase (docs/GIT.md → «Запрещённые команды»).
cat >&2 <<'EOF'
rebase отклонён: он переписывает существующие коммиты и меняет их хэши.
Почему: отчёты о задачах и ревью ссылаются на хэши; после rebase они ведут в никуда, а незакоммиченная
работа других агентов в общем дереве может потеряться при конфликте.
Как надо: история только дополняется — исправление идёт новым коммитом поверх.
Правило: docs/GIT.md → «Запрещённые команды».
EOF
exit 1
