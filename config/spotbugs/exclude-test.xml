<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs для тестов (tasks/46 п.6): общие исключения из exclude.xml и тестовые. Исключаются только правила целиком (или для тестов целиком), с причиной.
  Точечных подавлений по классу или методу нет.
-->
<FindBugsFilter>
  <!-- EI_EXPOSE_REP, EI_EXPOSE_REP2, MS_EXPOSE_REP, EI_EXPOSE_STATIC_REP2: SpotBugs считает изменяемой любую
       коллекцию и любой не-final тип. Выборка из 22 мест (п.6): record и поля держат неизменяемые копии
       (List.copyOf, Stream.toList, Map.of), а сущности и шина Minecraft (SpiritEntity, ServerLevel, IEventBus)
       передаются по ссылке намеренно — копия мира невозможна. Массивы копируются явно (RestRequest,
       PlacedBlockCodec — PMD ArrayIsStoredDirectly). -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP,EI_EXPOSE_STATIC_REP2"/>
  </Match>
  <!-- NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE: повторный вызов аксессора после проверки на null
       (if (p.min() != null) p.min().longValue()). Аксессоры record стабильны; null-контракт core держит NullAway,
       который так же считает путь из аксессоров без аргументов стабильным. -->
  <Match>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>
  <!-- VA_FORMAT_STRING_USES_NEWLINE: перевод строки в формате — часть текста (JSON в текстовом блоке, строка CSV);
       %n дал бы CRLF на Windows и другой файл на другой машине. -->
  <Match>
    <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
  </Match>
  <!-- Только тесты: Random с явным зерном — воспроизводимый генератор сценария; значение вызова внутри assertThrows
       не нужно — проверяется исключение; тестовые двойники однопоточны. -->
  <Match>
    <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE,RV_RETURN_VALUE_IGNORED_INFERRED,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE,AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
  </Match>
</FindBugsFilter>
