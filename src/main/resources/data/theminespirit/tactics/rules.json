{
  "hard": [
    {"id": "no_enemies_ignore", "priority": 100,
     "when": [{"fact": "enemy.count", "op": "==", "value": 0}],
     "then": {"decision": "IGNORE"}},
    {"id": "cornered_fight", "priority": 95,
     "when": [{"fact": "env.escapeAvailability", "op": "==", "value": 0}, {"fact": "enemy.nearest", "op": "<=", "value": 3}],
     "then": {"decision": "FIGHT"}},
    {"id": "critical_hp_retreat", "priority": 90,
     "when": [{"fact": "self.hpFraction", "op": "<", "value": 0.25}, {"fact": "enemy.count", "op": ">=", "value": 1}],
     "then": {"decision": "RETREAT"}},
    {"id": "explosive_close_retreat", "priority": 85,
     "when": [{"fact": "enemy.nearestExplosive", "op": "<=", "value": 5}],
     "then": {"decision": "RETREAT"}},
    {"id": "explosive_band_retreat", "priority": 84,
     "when": [{"fact": "state.tactical", "op": "==", "value": "retreating"}, {"fact": "enemy.nearestExplosive", "op": "<", "value": 8}],
     "then": {"decision": "RETREAT"}},
    {"id": "passive_never_fights", "priority": 80,
     "when": [{"fact": "order.mode", "op": "==", "value": "passive"}, {"fact": "enemy.count", "op": ">=", "value": 1}],
     "then": {"decision": "RETREAT"}},
    {"id": "no_fight_near_lava", "priority": 70,
     "when": [{"fact": "env.lavaNear", "op": "<=", "value": 2}],
     "then": {"exclude": ["FIGHT"]}},
    {"id": "outside_leash_ignore", "priority": 60,
     "when": [{"fact": "order.leashLeft", "op": "<", "value": 0}, {"fact": "order.mode", "op": "in", "value": ["guard_area", "defensive"]}, {"fact": "enemy.nearest", "op": ">", "value": 3}],
     "then": {"decision": "IGNORE"}},
    {"id": "uninitiated_ignore", "priority": 58,
     "when": [{"fact": "order.initiates", "op": "==", "value": false}, {"fact": "enemy.targetingSelf", "op": "==", "value": false}],
     "then": {"decision": "IGNORE"}},
    {"id": "outside_engage_ignore", "priority": 55,
     "when": [{"fact": "state.tactical", "op": "==", "value": "calm"}, {"fact": "order.engageLeft", "op": "<", "value": 0}, {"fact": "enemy.targetingSelf", "op": "==", "value": false}],
     "then": {"decision": "IGNORE"}}
  ],
  "actions": [
    {"id": "shoot_explosive", "priority": 55,
     "when": [{"fact": "self.hasRanged", "op": "==", "value": true}, {"fact": "enemy.anyExplosive", "op": "==", "value": true}, {"fact": "enemy.nearestExplosive", "op": ">=", "value": 3}, {"fact": "enemy.visibleCount", "op": ">=", "value": 1}],
     "then": {"action": "SHOOT"}},
    {"id": "shoot_at_range", "priority": 50,
     "when": [{"fact": "self.hasRanged", "op": "==", "value": true}, {"fact": "enemy.nearest", "op": ">=", "value": 5}, {"fact": "enemy.visibleCount", "op": ">=", "value": 1}],
     "then": {"action": "SHOOT"}},
    {"id": "defend_area", "priority": 40,
     "when": [{"fact": "order.mode", "op": "==", "value": "guard_area"}],
     "then": {"action": "DEFEND_AREA"}},
    {"id": "protect_ward", "priority": 30,
     "when": [{"fact": "order.mode", "op": "==", "value": "protect"}, {"fact": "order.protectedThreatened", "op": "==", "value": true}],
     "then": {"action": "PROTECT"}},
    {"id": "engage_default", "priority": 10, "when": [], "then": {"action": "ENGAGE"}},
    {"id": "retreat_default", "priority": 10, "when": [], "then": {"action": "RETREAT"}},
    {"id": "continue_default", "priority": 10, "when": [], "then": {"action": "CONTINUE"}}
  ],
  "modeTransitions": [
    {"id": "aggressive_tires", "from": ["aggressive"], "to": "defensive",
     "when": [{"fact": "self.hpFraction", "op": "<", "value": 0.3}]},
    {"id": "aggressive_recovers", "from": ["defensive"], "to": "aggressive",
     "when": [{"fact": "order.ordered", "op": "==", "value": "aggressive"}, {"fact": "self.hpFraction", "op": ">=", "value": 0.7}]},
    {"id": "protect_without_ward", "from": ["protect"], "to": "defensive",
     "when": [{"fact": "order.wardPresent", "op": "==", "value": false}]},
    {"id": "protect_restored", "from": ["defensive"], "to": "protect",
     "when": [{"fact": "order.ordered", "op": "==", "value": "protect"}, {"fact": "order.wardPresent", "op": "==", "value": true}]},
    {"id": "guard_without_zone", "from": ["guard_area"], "to": "defensive",
     "when": [{"fact": "order.zoneSet", "op": "==", "value": false}]},
    {"id": "guard_restored", "from": ["defensive"], "to": "guard_area",
     "when": [{"fact": "order.ordered", "op": "==", "value": "guard_area"}, {"fact": "order.zoneSet", "op": "==", "value": true}]}
  ],
  "states": [
    {"id": "calm_to_engaged", "from": ["calm"], "to": "engaged", "decision": "FIGHT", "when": []},
    {"id": "to_retreating", "from": ["calm", "engaged"], "to": "retreating", "decision": "RETREAT", "when": []},
    {"id": "engaged_to_calm", "from": ["engaged"], "to": "calm",
     "when": [{"fact": "enemy.count", "op": "==", "value": 0}, {"fact": "time.sinceEnemySeen", "op": ">=", "value": 20}]},
    {"id": "retreating_to_engaged", "from": ["retreating"], "to": "engaged", "decision": "FIGHT", "when": []},
    {"id": "retreating_to_recovering", "from": ["retreating"], "to": "recovering",
     "when": [{"fact": "enemy.visibleCount", "op": "==", "value": 0}, {"fact": "time.sinceEnemySeen", "op": ">=", "value": 60}]},
    {"id": "recovering_to_retreating", "from": ["recovering"], "to": "retreating", "decision": "RETREAT", "when": []},
    {"id": "recovering_to_engaged", "from": ["recovering"], "to": "engaged", "decision": "FIGHT", "when": []},
    {"id": "recovering_healed", "from": ["recovering"], "to": "calm",
     "when": [{"fact": "self.hpFraction", "op": ">=", "value": 0.7}]},
    {"id": "recovering_timeout", "from": ["recovering"], "to": "calm",
     "when": [{"fact": "time.inState", "op": ">=", "value": 600}]}
  ],
  "retreat": {
    "methods": [
      {"id": "retreat_home", "method": "HOME",
       "requires": [{"fact": "env.homeReachable", "op": "==", "value": true}, {"fact": "env.homeDistance", "op": "<=", "value": 80}, {"fact": "derived.speedRatio", "op": ">=", "value": 0.9}],
       "utility": {"base": 1.0, "fact": "env.homeDistance", "perUnit": -0.00625},
       "bonus": []},
      {"id": "retreat_cover", "method": "COVER",
       "requires": [{"fact": "env.coverDistance", "op": "<=", "value": 12}],
       "utility": {"base": 0.4},
       "bonus": [{"when": [{"fact": "enemy.anyRanged", "op": "==", "value": true}], "add": 0.4}]},
      {"id": "retreat_kite", "method": "KITE",
       "requires": [{"fact": "self.hasRanged", "op": "==", "value": true}, {"fact": "derived.speedRatio", "op": ">=", "value": 1.0}],
       "utility": {"base": 0.7},
       "bonus": []},
      {"id": "retreat_water", "method": "WATER",
       "requires": [{"fact": "env.waterDistance", "op": "<=", "value": 8}, {"fact": "enemy.anySwims", "op": "==", "value": false}, {"fact": "enemy.anyRanged", "op": "==", "value": false}],
       "utility": {"base": 0.6},
       "bonus": []},
      {"id": "retreat_water_bucket", "method": "WATER",
       "requires": [{"fact": "self.hasWaterBucket", "op": "==", "value": true}, {"fact": "enemy.anySwims", "op": "==", "value": false}, {"fact": "enemy.anyRanged", "op": "==", "value": false}],
       "utility": {"base": 0.55},
       "bonus": []},
      {"id": "retreat_barricade", "method": "BARRICADE",
       "requires": [{"fact": "self.blocks", "op": ">=", "value": 6}, {"fact": "enemy.anyRanged", "op": "==", "value": false}, {"fact": "enemy.anyExplosive", "op": "==", "value": false}, {"fact": "enemy.nearest", "op": ">=", "value": 3}],
       "utility": {"base": 0.5},
       "bonus": []},
      {"id": "retreat_pillar", "method": "PILLAR",
       "requires": [{"fact": "self.blocks", "op": ">=", "value": 8}, {"fact": "enemy.anyRanged", "op": "==", "value": false}, {"fact": "enemy.anyFlies", "op": "==", "value": false}],
       "utility": {"base": 0.4},
       "bonus": []},
      {"id": "retreat_away", "method": "AWAY",
       "requires": [{"fact": "derived.speedRatio", "op": ">=", "value": 1.0}, {"fact": "enemy.nearest", "op": ">", "value": 3}, {"fact": "enemy.anyRanged", "op": "==", "value": false}],
       "utility": {"base": 0.2},
       "bonus": []}
    ],
    "callHelp": {"when": [{"fact": "order.helpAvailable", "op": "==", "value": true}]}
  }
}
