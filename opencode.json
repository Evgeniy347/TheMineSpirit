{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "*taskkill*": "deny",
      "*Stop-Process*": "deny",
      "kill *": "deny",
      "*; kill *": "deny",
      "*&& kill *": "deny",
      "*pkill*": "deny",
      "*killall*": "deny",
      "*gradlew*--stop*": "deny",
      "*gradle*--stop*": "deny"
    },
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "question": "deny"
  }
}
